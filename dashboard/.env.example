# Backend Lambda Function URL (server-only; never exposed to the browser).
API_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-northeast-1.on.aws/

# Shared secret the backend's x-api-key header requires. Same value as the
# SSM parameter /grok-trade/API_SHARED_SECRET. Never prefix this with
# NEXT_PUBLIC_ - that would bundle it into client-side JS.
API_SHARED_SECRET=

# HTTP Basic auth in front of the whole dashboard (src/middleware.ts).
# Both must be set or every request gets a 503 (fail closed).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
